---
title: Blog
generator: pagination
pagination:
  max_per_page: 30
  provider: data.posts
use: [posts]
---

<p>Here are the {{ data.posts|length|number_format }} blog posts and public notes I have written (so far), on topics including software development, open source software, productivity, public speaking and personal updates.</p>

{% set month_and_year = null -%}

<div style="margin-top: 2rem;">
  <ul>
    {% for post in page.pagination.items %}
      {% set post_month_and_year = post.date|date('F Y') %}

      {% if post_month_and_year != month_and_year %}
        {% set month_and_year = post_month_and_year %}

        {# Close the current section #}
        </ul>

        {# Start a new section #}
        <h2>{{ post_month_and_year }}</h2>
        <ul>
      {% endif %}

      <li>
        <a href="{{ post.url|trim('/', 'right') }}">{{ post.title }}</a> - {{ post.date|date('jS F Y') }}
      </li>
    {% endfor %}

    {% if page.pagination.previous_page or page.pagination.next_page %}
      <nav class="flex justify-center pt-10 space-x-6">
        {% if page.pagination.previous_page %}<a href="{{ site.url }}{{ page.pagination.previous_page.url }}">&larr; Newer Posts{% endif %}<br />
        {% if page.pagination.next_page %}<a href="{{ site.url }}{{ page.pagination.next_page.url }}">Older Posts &rarr;</a>{% endif %}<br />
      </nav>
    {% endif %}
  </ul>
</div>
