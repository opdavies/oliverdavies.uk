---
title: Blog
generator: pagination
pagination:
  max_per_page: 30
  provider: data.posts
use: [posts]
---

{% block head_meta %}
<link rel="alternate" type="application/rss+xml" title="Oliver Davies" href="/rss/blog.xml" />
{% endblock %}

{% block content %}
<div>
  <p>Here are the {{ data.posts|length|number_format }} blog posts and public notes I have written (so far), on topics including software development, open source software, productivity, public speaking and personal updates.</p>
</div>

{% set month_and_year = null -%}

<div>
  <ul>
    {% for post in page.pagination.items %}
      {% set post_month_and_year = post.date|date('F Y') %}

      {% if post_month_and_year != month_and_year %}
        {% set month_and_year = post_month_and_year %}

        {# Close the current section #}
        </ul>

        {# Start a new section #}
        <h2>{{ post_month_and_year }}</h2>
        <ul>
      {% endif %}

      <li>
        <a href="{{ post.url|trim('/', 'right') }}">{{ post.title }}</a> -
        <time datetime="{{ post.date|date('Y-m-d') }}">
          {{ post.date|date('jS F Y') }}
        </time>
      </li>
    {% endfor %}
  </ul>

  {% if page.pagination.previous_page or page.pagination.next_page %}
    <nav class="pagination" aria-label="pager">
      {% if page.pagination.previous_page %}<a rel="next" href="{{ site.url }}{{ page.pagination.previous_page.url }}">&larr; Newer Posts{% endif %}<br />
      {% if page.pagination.next_page %}<a rel="prev" href="{{ site.url }}{{ page.pagination.next_page.url }}">Older Posts &rarr;</a>{% endif %}<br />
    </nav>
  {% endif %}
</div>
{% endblock %}
