#!/usr/bin/env bash

set -euo pipefail

cd "source/_posts"

for filepath in *; do
  [ -f "$filepath" ] || continue

  filename="$(basename "$filepath")"

  if [[ "$filename" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})(-\1)?\.md$ ]]; then
    date="${BASH_REMATCH[1]}"
    needs_title=true
  else
    needs_title=false
  fi

  post_date="$(sed -nE "s/^date:[[:space:]]*['\"]?([^'\"]+)['\"]?.*/\1/p" "$filepath")"
  post_date="${post_date:0:10}"

  if [ -z "$post_date" ]; then
    post_date="$(sed -nE "s/^pubDate:[[:space:]]*['\"]?([^'\"]+)['\"]?.*/\1/p" "$filepath")"
  fi

  [ -z "$post_date" ] && {
    echo "No date found in $filename, skipping"
    continue
  }

  if [ "$needs_title" = true ]; then
    post_title="$(sed -nE "s/^title:[[:space:]]*['\"]?(.+?)['\"]?$/\1/p" "$filepath")"

    if [ -z "$post_title" ]; then
      echo "No title found in $filename, skipping"
      continue
    fi

    slug="$(printf '%s' "$post_title" \
      | tr '[:upper:]' '[:lower:]' \
      | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"

    new_filename="$post_date-$slug.md"
  else
    new_filename="$post_date-$filename"
  fi

  git mv "$filename" "$new_filename"

  sed -i '/^date:[[:space:]]*/d' "$new_filename"
done

rm source/_posts/\~*
